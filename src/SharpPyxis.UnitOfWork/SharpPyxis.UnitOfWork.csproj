<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>SharpPyxis.UnitOfWork</RootNamespace>
    <PackageId>SharpPyxis.UnitOfWork</PackageId>
    <Version>2.0.0</Version>
    <Authors>Frédéric Ringeard</Authors>
    <Copyright>Copyright © 2026 Frédéric Ringeard</Copyright>
    <Description>À-la-carte Unit of Work: owns the connection and transaction and resolves repositories on demand through a typed factory registry — no reflection, no fixed repository list. Ships a relational (ADO.NET) and an in-memory implementation behind one IUnitOfWorkFactory, so switching backing store is a composition-root decision. Zero dependencies.</Description>
    <PackageTags>unit-of-work;repository;ado.net;in-memory;transaction;dbconnection;primitives</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SharpPyxis/SharpPyxis.Packages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SharpPyxis/SharpPyxis.Packages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
